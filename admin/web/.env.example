# Backend FastAPI (admin/backend). Copy to .env.local to override.

# Where Next proxies /api/* and /camera (rewrites in next.config.ts). Server-side, read at build/start.
BACKEND_URL=http://localhost:8000

# Console WebSocket, opened directly by the browser (not proxied).
# If unset, the app uses ws(s)://<page host>:8000/ws/console, i.e. ws://localhost:8000/ws/console in development.
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000/ws/console
